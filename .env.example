# MongoDB Database URL (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/giftora?retryWrites=true&w=majority

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=giftora_super_secret_jwt_key_2026_production_grade_change_in_prod

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Use test mode keys rzp_test_... during development)
RAZORPAY_KEY_ID=rzp_test_giftora123456
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_giftora123456

# Admin Setup Key (for initial admin provisioning)
ADMIN_SETUP_SECRET=giftora_admin_secret_key_2026
